# Modèle du secret Kubernetes du relais d'upload SharePoint (la CI le crée à
# partir des secrets GitHub de l'environnement prod).
# Pour un déploiement manuel : copier en secrets.yaml et remplir.
# NE JAMAIS commiter secrets.yaml (ignoré par git).
#
# Aucun secret BoondManager ici : le serveur est une ressource protégée OAuth2,
# chaque client MCP envoie son propre token Boond.
apiVersion: v1
kind: Secret
metadata:
  name: boond-mcp-secrets
  namespace: tools4staff
type: Opaque
stringData:
  # App Entra ID (client credentials, permission Graph Sites.Selected + write
  # accordée sur le site ci-dessous)
  BOOND_MCP_SHAREPOINT_CLIENT_ID: "<entra-app-client-id>"
  BOOND_MCP_SHAREPOINT_CLIENT_SECRET: "<entra-app-client-secret>"
  # Site de transit : https://<tenant>.sharepoint.com/sites/<site>
  BOOND_MCP_SHAREPOINT_SITE: "https://symoliagroup-my.sharepoint.com/sites/"
